{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@booga/vblocks": [
        "./src"
      ],
      "@booga/vblocks/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "demo/src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
